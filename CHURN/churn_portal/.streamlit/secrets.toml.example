# Copie este archivo como secrets.toml y complete los valores. secrets.toml no se sube a git.
# Sin app_password el envío corre en modo demostración y no manda nada.
[email]
username = "cuenta.que.envia@gmail.com"   # cuenta de Gmail que envía
app_password = ""                          # contraseña de aplicación de 16 letras (myaccount.google.com/apppasswords)
demo_name = "Su nombre"                    # cómo aparece en la lista de clientes y en el correo
demo_email = "usted@gmail.com"             # dirección del cliente CLI-0200
allowed = ["usted@gmail.com"]              # únicas direcciones que pueden recibir correos reales
